# CATTLEX Environment Configuration Example
PROJECT_NAME="CATTLEX"
ENVIRONMENT="production"

# Database Configuration (PostgreSQL in Docker / SQLite in Local)
DATABASE_URL="postgresql://cattlex_user:cattlex_secure_password@localhost:5432/cattlex_db"
# DATABASE_URL="sqlite:///./cattlex.db"

# JWT Secret Key for Authentication
JWT_SECRET="replace-with-a-very-secure-random-secret-key-32-chars-minimum"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MQTT Broker
MQTT_HOST="localhost"
MQTT_PORT=1883

# Network Endpoints
BACKEND_URL="http://localhost:8000"
FRONTEND_URL="http://localhost:5173"
